# ---------------------------------------------------------------------------
# Python build / cache artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store

# ---------------------------------------------------------------------------
# Data and experiment outputs
# ---------------------------------------------------------------------------
# The raw BGL log is ~700 MB and the processed dataset is regenerated by
# scripts/preprocess.py, so neither belongs in git.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Experiment outputs (checkpoints, predictions, LLM response cache).
# Small, reportable artifacts (final metrics, induced rules, the trained
# LogBERT checkpoint) are copied into results/ and committed from there.
outputs/

# Secrets for LLM providers
.env
