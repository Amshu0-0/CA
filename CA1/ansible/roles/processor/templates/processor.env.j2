# Settings for the processor container. Ansible writes this file, so do not edit it by hand.
# Docker passes every line below into the container as an environment variable.

# Kafka broker address (the broker VM's private IP and the Kafka port) and the topic to read from.
KAFKA_BROKER={{ hostvars[groups['broker'][0]].private_ip }}:{{ kafka_port }}
KAFKA_TOPIC={{ kafka_topic }}

# MongoDB address (the database VM's private IP and the MongoDB port), plus the database and collection.
MONGO_HOST={{ hostvars[groups['database'][0]].private_ip }}
MONGO_PORT={{ mongo_port }}
MONGO_DB={{ mongo_db }}
MONGO_COLLECTION={{ mongo_collection }}

# MongoDB username and password from the encrypted Ansible Vault.
MONGO_USER={{ vault_mongo_root_username }}
MONGO_PASSWORD={{ vault_mongo_root_password }}
