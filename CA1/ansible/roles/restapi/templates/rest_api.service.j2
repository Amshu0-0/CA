# This systemd service keeps the REST API running as a background service on the database VM.

[Unit]
# Name shown by systemd for this service.
Description=CA1 REST API

# Wait until networking and Docker are available before starting the REST API.
After=network.target docker.service


[Service]
# Run the API as the ubuntu user instead of root.
User=ubuntu

# Run the application from the folder where
# Ansible will copy rest_app.py.
WorkingDirectory=/home/ubuntu

# Read the API's settings (MongoDB address, database name, credentials, and port) from this file.
# Ansible writes it from config.yml and the encrypted Ansible Vault.
# systemd reads it as root before starting the API, so the file can stay private to root.
EnvironmentFile=/etc/ca1/rest_api.env

# Start the Flask REST API.
ExecStart=/usr/bin/python3 /home/ubuntu/rest_app.py

# Restart the API automatically if it crashes.
Restart=on-failure

# Wait 5 seconds before trying to restart it.
RestartSec=5


[Install]
# Start this service automatically during normal system startup.
WantedBy=multi-user.target
