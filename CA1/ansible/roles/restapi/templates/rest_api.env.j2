# Settings for the REST API service. Ansible writes this file, so do not edit it by hand.
# systemd reads every line below and passes it to the API as an environment variable.

# MongoDB address. MongoDB runs on this same VM, so the API connects to localhost.
MONGO_HOST=localhost
MONGO_PORT={{ mongo_port }}

# Database and collection that hold the network flows.
MONGO_DB={{ mongo_db }}
MONGO_COLLECTION={{ mongo_collection }}

# MongoDB username and password from the encrypted Ansible Vault.
MONGO_USER={{ vault_mongo_root_username }}
MONGO_PASSWORD={{ vault_mongo_root_password }}

# The port the REST API listens on.
REST_PORT={{ rest_port }}
