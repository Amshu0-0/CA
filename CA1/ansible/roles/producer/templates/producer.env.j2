# Settings for the producer container. Ansible writes this file, so do not edit it by hand.
# Docker passes every line below into the container as an environment variable.

# Kafka broker address (the broker VM's private IP and the Kafka port) and the topic to write to.
KAFKA_BROKER={{ hostvars[groups['broker'][0]].private_ip }}:{{ kafka_port }}
KAFKA_TOPIC={{ kafka_topic }}

# The CSV file to replay. It is built into the producer image.
DATASET_FILE={{ dataset_file }}
