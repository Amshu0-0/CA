# Private keys
*.pem
*.key

# Environment files
.env

# macOS files
.DS_Store

# Python files
__pycache__/
*.pyc

# Terraform working directory
.terraform/

# Terraform variable files
# terraform.tfvars will contain your real IP
terraform.tfvars
*.tfvars
*.tfvars.json

# Ansible inventory - auto-generated by Terraform, contains real IPs
inventory.ini

# Terraform state files
# These contain details about the infrastructure Terraform creates
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Ansible secrets
.vault_pass
CA1/ansible/group_vars/all/vault.yml
